<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Barangay_Office.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Barangay_Office"
    xmlns:views="clr-namespace:Barangay_Office.Views"
    Shell.FlyoutBehavior="Disabled">

    <!--Loading Page-->
    <ShellContent
        Title="Loading"
        ContentTemplate="{DataTemplate views:LoadingPage}"
        Shell.FlyoutBehavior="Disabled"
        Shell.FlyoutItemIsVisible="False"
        Route="LoadingPage"/>

    <!--Login Page-->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" 
        Shell.FlyoutBehavior="Disabled"
        Shell.FlyoutItemIsVisible="False"/>

    <!-- Signup Page -->
    <ShellContent
        Title="Signup"
        ContentTemplate="{DataTemplate views:SignupPage}"
        Route="SignupPage"
        Shell.FlyoutBehavior="Disabled"
        Shell.FlyoutItemIsVisible="False"/>
    
    <!-- Admin Signup Page-->
    <ShellContent
        Title="Admin Signup"
        ContentTemplate="{DataTemplate views:AdminSignupPage}"
        Route="AdminSignupPage"
        Shell.FlyoutBehavior="Disabled"
        Shell.FlyoutItemIsVisible="False"/>

    <!-- Customer TabBar -->
    <TabBar>
        <Tab Title="Customer Panel">
            <!-- Customer Page-->
            <ShellContent
                Title="Customer"
                ContentTemplate="{DataTemplate views:CustomerPage}"
                Route="CustomerPage"/>

            <!--Profile Page-->
            <ShellContent
                Title="Profile"
                ContentTemplate="{DataTemplate views:ProfilePage}"
                Route="ProfilePage"
                Shell.NavBarIsVisible="False"
                Shell.FlyoutBehavior="Disabled"/>
        </Tab>
    </TabBar>

    <!-- Admin TabBar -->
    <TabBar>
        <Tab Title="Admin Panel" Icon="profile.png">
            <!-- Admin Page-->
            <ShellContent
                Title="Admin"
                ContentTemplate="{DataTemplate local:MainPage}"
                Shell.NavBarIsVisible="False"
                Route="MainPage"/>



            <!-- Admin Profile Page-->
            <ShellContent
                Title="Profile"
                ContentTemplate="{DataTemplate views:AdminProfile}"
                Route="AdminProfile"
                Shell.FlyoutBehavior="Disabled"
                Shell.NavBarIsVisible="False"/>
        </Tab>
    </TabBar>


    <!-- forgotten passwoord -->
    <ShellContent 
        Title="Forgot Password" 
        ContentTemplate="{DataTemplate views:ForgotPasswordPage}" 
        Route="ForgotPasswordPage" 
        Shell.FlyoutItemIsVisible="False"
        Shell.NavBarIsVisible="False"/>
</Shell>
