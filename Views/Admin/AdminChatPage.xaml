<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Barangay_Office.ViewModels"
             xmlns:models="clr-namespace:Barangay_Office.Models"
             xmlns:converters="clr-namespace:Barangay_Office.Converters"
             x:Class="Barangay_Office.Views.AdminChatPage"
             x:DataType="vm:AdminChatViewModel"
             BackgroundColor="LightGray"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:SenderToAlignmentConverter x:Key="SenderToAlignmentConverter"/>
            <converters:SenderToColorConverter x:Key="SenderToColorConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto, 100">
        <!-- Header -->
        <StackLayout Grid.Row="0" BackgroundColor="#1f0572" Padding="10">
            <Label Text="Customer Service Management" 
                   TextColor="White" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"/>
        </StackLayout>
        
        <!--message area-->
        <Border Grid.Row="1" 
                Stroke="#1f0572"
                StrokeThickness="1"
                Margin="10">
            <ScrollView>
                <VerticalStackLayout Spacing="10" Padding="10">
                    <CollectionView x:Name="MessageCollection"
                                    ItemsSource="{Binding Messages}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CustomerServiceMessage">
                                <Grid Padding="5">
                                    <Border BackgroundColor="{Binding SenderID, Converter={StaticResource SenderToColorConverter}}"
                                           Padding="10"
                                           StrokeShape="RoundRectangle 10"
                                           HorizontalOptions="{Binding SenderID, Converter={StaticResource SenderToAlignmentConverter}}">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding SenderID}" 
                                                   FontSize="12" 
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding Content}" 
                                                   FontSize="16" />
                                            <Label Text="{Binding Timestamp, StringFormat='{0:MM/dd/yyyy hh:mm tt}'}" 
                                                   FontSize="10" 
                                                   HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Message Input Area -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="10">
            <Entry Grid.Column="0" 
                   Placeholder="Type your response here..." 
                   WidthRequest="250"
                   Text="{Binding NewMessage}" 
                   TextColor="Black"
                   ReturnCommand="{Binding SendMessageCommand}"/>
            
            <Button Grid.Column="1" 
                    Text="Send" 
                    WidthRequest="90"
                    Command="{Binding SendMessageCommand}" 
                    BackgroundColor="#1f0572"
                    TextColor="White"
                    CornerRadius="5"
                    Margin="5,0,0,0"/>
        </Grid>
        <StackLayout Grid.Row="3" WidthRequest="200">
            <Border StrokeShape="RoundRectangle 20">
                
                <Button Text="Back"
                        BackgroundColor="#1f0572"
                        Command="{Binding BackButtonCommand}"
                        TextColor="White"
                        VerticalOptions="Center"
                        HeightRequest="30"/>
            </Border>
        </StackLayout>
    </Grid>
</ContentPage>