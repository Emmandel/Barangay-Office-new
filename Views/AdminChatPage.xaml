<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Barangay_Office.ViewModels"
             xmlns:converters="clr-namespace:Barangay_Office.Converters"
             x:Class="Barangay_Office.Views.AdminChatPage"
             Title="AdminChatPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:AdminToColorConverter x:Key="AdminToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <StackLayout>
        <ListView x:Name="ChatListView" ItemsSource="{Binding Messages}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Padding="5">
                            <Label Text="{Binding SenderID}" FontAttributes="Bold" />
                            <Label Text="{Binding Content}" />
                            <Label Text="{Binding Timestamp, StringFormat='{0:hh:mm tt}'}" FontSize="10" />
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Entry x:Name="MessageEntry" Placeholder="Type a message..." />
        <Button Text="Send" Command="{Binding SendMessageCommand}" />
    </StackLayout>
</ContentPage>