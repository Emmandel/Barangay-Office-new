<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Barangay_Office.ViewModels"
             xmlns:converters="clr-namespace:Barangay_Office.Converters"
             x:Class="Barangay_Office.Views.AdminChatPage"
             Title="Customer Service Admin">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:SenderToAlignmentConverter x:Key="SenderToAlignmentConverter"/>
            <converters:SenderToColorConverter x:Key="SenderToColorConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Header -->
        <StackLayout Grid.Row="0" BackgroundColor="#2C3E50" Padding="10">
            <Label Text="Customer Service Management" 
                   TextColor="White" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"/>
        </StackLayout>
        
        <!--message area-->
        <Border Grid.Row="1" 
                Stroke="LightGray"
                StrokeThickness="1"
                Margin="10">
            <ScrollView>
                <VerticalStackLayout Spacing="10" Padding="10">
                    <CollectionView x:Name="MessageCollection"
                                  ItemsSource="{Binding Messages}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="5">
                                    <Frame BackgroundColor="{Binding SenderID, Converter={StaticResource SenderToColorConverter}}"
                                           Padding="10"
                                           CornerRadius="10"
                                           HasShadow="True"
                                           HorizontalOptions="{Binding SenderID, Converter={StaticResource SenderToAlignmentConverter}}">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding SenderID}" 
                                                   FontSize="12" 
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding Content}" 
                                                   FontSize="16" />
                                            <Label Text="{Binding Timestamp, StringFormat='{0:MM/dd/yyyy hh:mm tt}'}" 
                                                   FontSize="10" 
                                                   HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Frame>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Message Input Area -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="10">
            <Entry Grid.Column="0" 
                   Placeholder="Type your response here..." 
                   Text="{Binding NewMessage}" 
                   ReturnCommand="{Binding SendMessageCommand}"/>
            <Button Grid.Column="1" 
                    Text="Send" 
                    Command="{Binding SendMessageCommand}" 
                    BackgroundColor="#2C3E50"
                    TextColor="White"
                    CornerRadius="5"
                    Margin="5,0,0,0"/>
        </Grid>
    </Grid>
</ContentPage>