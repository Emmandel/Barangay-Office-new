<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Barangay_Office.ViewModels"
             x:Class="Barangay_Office.Views.Controls.AdminHeaderMenuControls"
             x:DataType="vm:AdminPageViewModel">
    
    <ContentView.BindingContext>
        <vm:AdminPageViewModel/>
    </ContentView.BindingContext>

    <HorizontalStackLayout BackgroundColor="#1f0572" Padding="10" WidthRequest="400" HorizontalOptions="Center" VerticalOptions="Center">
        <Button Text="Profile" Style="{StaticResource AdminHeaderMenu}" Command="{Binding AdminNavigate}" CommandParameter="AdminProfile"/>
        
        <Button Text="Home" Style="{StaticResource AdminHeaderMenu}" Command="{Binding AdminNavigate}" CommandParameter="MainPage"/>
        
        <Button Text="Notifications" Style="{StaticResource AdminHeaderMenu}" Command="{Binding AdminNavigate}" CommandParameter="AdminNotificationPage"/>
    </HorizontalStackLayout>
    
</ContentView>