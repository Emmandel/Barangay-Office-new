<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Barangay_Office.ViewModels"
             x:Class="Barangay_Office.Views.Controls.CustomerHeaderMenuControls">

    <ContentView.BindingContext>
        <vm:CustomerPageViewModel/>
    </ContentView.BindingContext>


    <HorizontalStackLayout BackgroundColor="#1f0572" Padding="10" WidthRequest="400" HorizontalOptions="Center" VerticalOptions="Center">
        <Button Text="Home" Style="{StaticResource HeaderButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="CustomerPage"/>
        
        <Button Text="Profile" Style="{StaticResource HeaderButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="ProfilePage"/>

        <Button Text="Services" Style="{StaticResource HeaderButtonStyle}"  Command="{Binding NavigateCommand}" CommandParameter="ServicesPage"/>

        <Button Text="Contacts" Style="{StaticResource HeaderButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="ContactInfoPage"/>

        <Button Text="About Us" Style="{StaticResource HeaderButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="AboutUsPage"/>
    </HorizontalStackLayout>
</ContentView>