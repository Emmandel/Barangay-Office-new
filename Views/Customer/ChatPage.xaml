<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Barangay_Office.Converters"
             xmlns:vm="clr-namespace:Barangay_Office.ViewModels"
             x:Class="Barangay_Office.Views.ChatPage"
             BackgroundColor="LightGray"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="LightGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- for banner layout -->
        <Path Data="m0,-10.5l699.00002, 0l0,110 -800, 0l0,-536.27948z">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="Red" Offset="0.1" />
                    <GradientStop Color="Blue" Offset="1.0" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- for Logo -->
        <StackLayout Margin="-85">
            <Border BackgroundColor="Black" 
                    HeightRequest="60" 
                    WidthRequest="60" 
                    StrokeShape="RoundRectangle 30" 
                    Padding="0" 
                    Margin="0,100,0,0" 
                    HorizontalOptions="Center">
                <Image Source="barangay_pembo.png" 
                       Aspect="AspectFill" 
                       Margin="0"/>
            </Border>
        </StackLayout>

        <!-- Devider -->
        <BoxView HeightRequest="2" 
                 BackgroundColor="#2C3E50" 
                 Margin="0,5,0,0" 
                 VerticalOptions="Center"/>

        <Border Grid.Row="0" 
                Stroke="Black"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 10"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Margin="0,410,0,0"
                HeightRequest="400"
                WidthRequest="350">
            
            <!--Scroll View-->
            <ScrollView BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        HeightRequest="400">
                <VerticalStackLayout Spacing="10" 
                                     Padding="10">
                    <CollectionView x:Name="MessageCollection"
                                    ItemsSource="{Binding Messages}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border BackgroundColor="{Binding SenderID, Converter={StaticResource SenderToColorConverter}}"
                                            Padding="10"
                                            StrokeShape="RoundRectangle 10"
                                            HorizontalOptions="{Binding SenderID, Converter={StaticResource SenderToAlignmentConverter}}">

                                        <VerticalStackLayout>
                                            <Label Text="{Binding SenderID}" 
                                                   FontSize="12" 
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding Content}" 
                                                   FontSize="16" />
                                            <Label Text="{Binding Timestamp, StringFormat='{0:MM/dd/yyyy hh:mm tt}'}" 
                                                   FontSize="10" 
                                                   HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>


        </Border>

        <Grid Grid.Row="1" 
              ColumnDefinitions="*, auto" 
              Margin="15,250,15,10" >

            <!--Entry-->
            <Border Grid.Column="0" 
                    HeightRequest="50"
                    Stroke="Black"
                    StrokeThickness="1"
                    Padding="2"
                    StrokeShape="RoundRectangle 5">
                <Entry Grid.Column="0"
                       BackgroundColor="#dedcdc"
                       Placeholder="Type your message here..."
                       Text="{Binding MessageEntry}"
                       TextColor="Black"
                       FontSize="13"
                       FontAttributes="Bold"
                       ReturnCommand="{Binding SendCommand}"/>
            </Border>
            
            <!--Send Button-->
            <Border Grid.Column="1"
                    HeightRequest="35"
                    WidthRequest="80"
                    Stroke="Black"
                    StrokeThickness="1"
                    Margin="4,0,-5,0"
                    StrokeShape="RoundRectangle 30">
                <Button Text="Send"
                        HeightRequest="0"
                        WidthRequest="100"
                        FontSize="12"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Command="{Binding SendCommand}"
                        BackgroundColor="#1f0572"
                        TextColor="White"
                        CornerRadius="30"/>
            </Border>
        </Grid>

        <!--Back Button-->
        <Border Grid.Row="2"
                Stroke="Black"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 30"
                HeightRequest="40"
                WidthRequest="120"
                Margin="0,0,0,90"
                BackgroundColor="Transparent"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Button Text="Back"
                    BackgroundColor="#1f0572"
                    TextColor="White"
                    WidthRequest="120"
                    FontSize="12"
                    CornerRadius="30"
                    Padding="0"
                    Margin="0"
                    HorizontalOptions="Center"
                    Command="{Binding BackButton}"/>
        </Border>
    </Grid>
</ContentPage>