<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:control="clr-namespace:Barangay_Office.Views.Controls"
             xmlns:vm="clr-namespace:Barangay_Office.ViewModels"
             x:Class="Barangay_Office.Views.ProfilePage"
             BackgroundColor="LightGray"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- for banner layout -->
        <Path Data="m0,-10.5l699.00002, 0l0,110 -800, 0l0,-536.27948z">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="Red" Offset="0.1" />
                    <GradientStop Color="Blue" Offset="1.0" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- for Logo -->
        <StackLayout Margin="-85">
            <Border BackgroundColor="Black" 
                    HeightRequest="60" 
                    WidthRequest="60" 
                    StrokeShape="RoundRectangle 30" 
                    Padding="0" 
                    Margin="0,100,0,0" 
                    HorizontalOptions="Center">
                <Image Source="barangay_pembo.png" 
                       Aspect="AspectFill" 
                       Margin="0"/>
            </Border>
        </StackLayout>
        
        <!--header menu-->
        <control:CustomerHeaderMenuControls/>

        <!-- Devider -->
        <BoxView HeightRequest="2" BackgroundColor="#2C3E50" Margin="0,85,0,0" VerticalOptions="Center"/>

        <ScrollView Grid.Row="1" BackgroundColor="Transparent" HeightRequest="575" Margin="0,0,0,15" VerticalOptions="CenterAndExpand" HorizontalOptions="Center">

            <VerticalStackLayout BackgroundColor="Transparent" Spacing="-2">

                <Border Stroke="Black" WidthRequest="1000" HeightRequest="200">
                    <VerticalStackLayout Spacing="10" Padding="13" BackgroundColor="Transparent">
                        <Label Text="Customer profile info should be here" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center" VerticalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>
                
                <Border Stroke="Black" WidthRequest="1000" HeightRequest="200">
                    <VerticalStackLayout Spacing="10" Padding="13" BackgroundColor="Transparent">
                        <Label Text="Customer profile info should be here" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center" VerticalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Stroke="Black" WidthRequest="1000" HeightRequest="200">
                    <VerticalStackLayout Spacing="10" Padding="13" BackgroundColor="Transparent">
                        <Label Text="Customer profile info should be here" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center" VerticalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" BackgroundColor="Transparent" Margin="0,20,0,20">
                    
                    <!--Reset password-->
                    <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="150" StrokeShape="RoundRectangle 30">
                        <Button Text="Reset Password"
                                Command="{Binding ToReset}"
                                HeightRequest="20"
                                BackgroundColor="Red"
                                TextColor="White"/>
                    </Border>
                
                    <!--logout-->
                    <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="150" StrokeShape="RoundRectangle 30">
                        <Button Text="logout"
                                Command="{Binding ToLogout}"
                                HeightRequest="20"
                                BackgroundColor="#1f0572"
                                TextColor="White"/>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>