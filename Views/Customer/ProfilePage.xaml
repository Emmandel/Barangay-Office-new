<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:control="clr-namespace:Barangay_Office.Controls"
             xmlns:vm="clr-namespace:Barangay_Office.ViewModels"
             x:Class="Barangay_Office.Views.ProfilePage"
             x:DataType="vm:CustomerProfileViewModel"
             BackgroundColor="LightGray"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">
    
    <!--do not remove this for it's a connection to the viewmodel-->
    <ContentPage.BindingContext>
        <vm:CustomerProfileViewModel/>
    </ContentPage.BindingContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- for banner layout -->
        <Path Data="m0,-10.5l699.00002, 0l0,110 -800, 0l0,-536.27948z">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="Red" Offset="0.1" />
                    <GradientStop Color="Blue" Offset="1.0" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- for Logo -->
        <StackLayout Margin="-85">
            <Border BackgroundColor="Black" 
                    HeightRequest="60" 
                    WidthRequest="60" 
                    StrokeShape="RoundRectangle 30" 
                    Padding="0" 
                    Margin="0,100,0,0" 
                    HorizontalOptions="Center">
                <Image Source="barangay_pembo.png" 
                       Aspect="AspectFill" 
                       Margin="0"/>
            </Border>
        </StackLayout>
        
        <!--header menu-->
        <control:CustomerHeaderMenuControls/>

        <!-- Devider -->
        <BoxView HeightRequest="2" BackgroundColor="#2C3E50" Margin="0,85,0,0" VerticalOptions="Center"/>

        <VerticalStackLayout Grid.Row="1" 
                             BackgroundColor="Transparent" 
                             WidthRequest="400" 
                             HeightRequest="575" 
                             Margin="0,0,0,15" 
                             VerticalOptions="Center" 
                             HorizontalOptions="Center">

                
            <!--Profile details-->
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Background="Transparent"
                                 WidthRequest="400"
                                 HeightRequest="515">
                <!--avatar and name-->
                <HorizontalStackLayout HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       BackgroundColor="Transparent"
                                       Padding="20,15,0,15"
                                       WidthRequest="360"
                                       Spacing="20">
                    <Border Stroke="Black"
                            StrokeShape="RoundRectangle 50">
                        <Image Source="appicon.png"
                               WidthRequest="50"
                               HeightRequest="50"
                               Aspect="AspectFit"/>
                    </Border>
                    
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Jessmar Marcaida"
                               FontAttributes="Bold"
                               TextColor="Black"/>
                        <Label Text="SampleTest@gmail.com"
                               TextColor="Black"
                               FontSize="9"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!--Bio or Description-->
                <Label Text="Description"
                       FontAttributes="Bold"
                       Padding="30,0,0,0"
                       TextColor="Black"/>
                <Label Text="Add a few description"
                       Padding="30,5,0,10"
                       FontSize="11"
                       TextColor="Black"/>
                <BoxView WidthRequest="400"
                         HorizontalOptions="Center"
                         HeightRequest="2"
                         Margin="10"
                         BackgroundColor="Gray"/>
                
                <!--Language-->
                <Label Text="Language"
                       Padding="30,0,0,0"
                       FontAttributes="Bold"
                       TextColor="Black"/>
                
                <control:LanguageDropdown/>
                
                <BoxView WidthRequest="400"
                         HorizontalOptions="Center"
                         HeightRequest="02"
                         Margin="-2"
                         BackgroundColor="Gray"/>
                
                <!--Notification-->
                <Label Text="Notification"
                       Padding="30,0,0,0"
                       Margin="0,12,0,0"
                       FontAttributes="Bold"
                       TextColor="Black"/>
                <HorizontalStackLayout WidthRequest="400"
                                       VerticalOptions="Center"
                                       Spacing="5"
                                       HorizontalOptions="Center">
                    <Label Text="General Notification"
                           Padding="30,0,0,0"
                           VerticalOptions="Center"
                           FontAttributes="Bold"
                           TextColor="Black"/>
                    <Switch IsToggled="True"
                            VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <BoxView WidthRequest="400"
                         HorizontalOptions="Center"
                         HeightRequest="2"
                         Margin="10"
                         BackgroundColor="Gray"/>


                <!--Theme-->
                <Button Text="Theme"
                        ImageSource="sun.png"
                        Command="{Binding ToggleTheme}"
                        HeightRequest="20"
                        BackgroundColor="Gray"
                        TextColor="White"/>

            </VerticalStackLayout>

            <!--Buttons-->
            <HorizontalStackLayout VerticalOptions="Center" 
                                       HorizontalOptions="Center"
                                       BackgroundColor="Gray"
                                       WidthRequest="360"
                                       HeightRequest="60"
                                       Margin="0"
                                       Padding="55"
                                       Spacing="50">
                <!--Reset password-->
                <Border VerticalOptions="Center" 
                            HorizontalOptions="Center" 
                            WidthRequest="100" 
                            HeightRequest="40" 
                            StrokeShape="RoundRectangle 30">
                    <Button Text="Reset Password"
                                Command="{Binding ToReset}"
                                FontSize="9"
                                FontAttributes="Bold"
                                BackgroundColor="#c10e0e"
                                TextColor="White"/>
                </Border>

                <!--logout-->
                <Border VerticalOptions="Center" 
                            HorizontalOptions="Center" 
                            WidthRequest="100" 
                            HeightRequest="40"
                            StrokeShape="RoundRectangle 30">
                    <Button Text="logout"
                                Command="{Binding ToLogout}"
                                FontSize="9"
                                FontAttributes="Bold"
                                BackgroundColor="#1f0572"
                                TextColor="White"/>
                </Border>
            </HorizontalStackLayout>
        </VerticalStackLayout>

    </Grid>
</ContentPage>