<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:control="clr-namespace:Barangay_Office.Views.Controls"
             xmlns:vm="clr-namespace:Barangay_Office.ViewModels"
             x:Class="Barangay_Office.Views.ServicesPage"
             x:DataType="vm:ServicesPageViewModel"
             BackgroundColor="White"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- for banner layout -->
        <Path Data="m0,-10.5l699.00002, 0l0,110 -800, 0l0,-536.27948z">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="Red" Offset="0.1" />
                    <GradientStop Color="Blue" Offset="1.0" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- for Logo -->
        <StackLayout Margin="-85">
            <Border BackgroundColor="Black" 
                    HeightRequest="60" 
                    WidthRequest="60" 
                    StrokeShape="RoundRectangle 30" 
                    Padding="0" 
                    Margin="0,100,0,0" 
                    HorizontalOptions="Center">
                <Image Source="barangay_pembo.png" 
                       Aspect="AspectFill" 
                       Margin="0"/>
            </Border>
        </StackLayout>

        <!-- Header menu -->
        <control:CustomerHeaderMenuControls/>

        <!-- Devider -->
        <BoxView HeightRequest="2" 
                 BackgroundColor="#2C3E50" 
                 Margin="0,85,0,0" 
                 VerticalOptions="Center"/>

        <ScrollView Grid.Row="1" 
                    BackgroundColor="Transparent"
                    HeightRequest="500" 
                    Margin="0,0,0,65"
                    x:DataType="vm:ServicesPageViewModel">
            <VerticalStackLayout Spacing="10" 
                                 Padding="13">

                <!-- Title -->
                <Label Text="Application Form" 
                       FontSize="Header" 
                       TextColor="Black" 
                       FontFamily="OpenSansRegular" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       Margin="0,10,0,10" />

                <!-- General Information -->
                <Border Stroke="#2C3E50" 
                        StrokeShape="RoundRectangle 10" 
                        Padding="15" 
                        BackgroundColor="#F0F0F0">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="General Information" 
                               FontSize="Small" 
                               FontAttributes="Bold" 
                               TextColor="Black" />
                        
                        <!--Fullname-->
                        <HorizontalStackLayout WidthRequest="300"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Spacing="15"
                                               BackgroundColor="Transparent">
                            
                            <!--Firstname-->
                            <Entry Placeholder="Firstname" 
                                   x:Name="Firstname" 
                                   FontSize="12" 
                                   TextTransform="Uppercase"
                                   WidthRequest="95"
                                   TextColor="Black"/>
                            
                            <!--Lastname-->
                            <Entry Placeholder="Lastname" 
                                   x:Name="Lastname" 
                                   WidthRequest="120"
                                   TextTransform="Uppercase"
                                   FontSize="12" 
                                   TextColor="Black"/>
                            
                            <!--Middlename-->
                            <Entry Placeholder="M.I" 
                                   x:Name="Middlename" 
                                   WidthRequest="20"
                                   HorizontalTextAlignment="Center"
                                   FontSize="12" 
                                   MaxLength="1"
                                   TextTransform="Uppercase"
                                   TextColor="Black"/>
                        </HorizontalStackLayout>
                        
                        <!--Address-->
                        <Entry Placeholder="Address" 
                               x:Name="AddressEntry" 
                               TextColor="Black"
                               FontSize="12" />
                        
                        <!--Gender-->
                        <RadioButton GroupName="Gender"
                                     Content="Male"
                                     IsChecked="{Binding IsMale}"/>
                        <RadioButton GroupName="Gender"
                                     Content="Female"
                                     IsChecked="{Binding IsFemale}"/>

                        <!--Citizenship-->
                        <Entry Placeholder="Citizenship" 
                               x:Name="CitizenshipEntry" 
                               TextColor="Black"
                               FontSize="12" />
                        
                        <!--ICR No.-->
                        <Entry Placeholder="ICR No.(If an alien)" 
                               x:Name="ICREntry" 
                               TextColor="Black"
                               IsVisible="{Binding IsIcrVisible}"
                               FontSize="12"/>
                        
                        <!--Place of Birth-->
                        <Picker Title="Place of Birth"
                                TitleColor="Black"
                                TextColor="Black"/>

                        <!--Birthdate-->
                        <Label Text=" BirthDate:" 
                               TextColor="Black" 
                               FontSize="12"/>
                        <DatePicker x:Name="DateOfBirthPicker" 
                                    Format="MM/dd/yyyy" 
                                    TextColor ="Black" 
                                    FontSize="12" />
                        
                        <!--Height-->
                        <Entry Placeholder="Height" 
                               x:Name="HeightEntry"
                               TextColor="Black"
                               FontSize="12" />
                        
                        <!--Weight-->
                        <Entry Placeholder="Height" 
                               x:Name="WeightEntry"
                               TextColor="Black"
                               FontSize="12" />
                        
                        <!--Civil Status-->
                        <RadioButton/>

                        <!--Contact No-->
                        <Entry Placeholder="Contact Number" 
                               x:Name="ContactNumberEntry" 
                               Keyboard="Telephone" 
                               FontSize="12" 
                               TextColor="Black"/>
                        
                        <!--Email Address-->
                        <Entry Placeholder="Email Address" 
                               x:Name="EmailAddressEntry" 
                               TextColor="Black"
                               Keyboard="Email" 
                               FontSize="12" />

                    </VerticalStackLayout>
                </Border>

                <!-- Services Picker -->
                <Label Text="Select Services" 
                       FontSize="20" 
                       FontAttributes="Bold"
                       HorizontalOptions="Start" 
                       TextColor="Black" />
                <Border Stroke="#2C3E50" 
                        StrokeShape="RoundRectangle 10" 
                        Padding="10" 
                        BackgroundColor="Transparent">
                    <Picker Title="Select-Form-Type" 
                            ItemsSource="{Binding FormTypes}"
                            SelectedItem="{Binding SelectedFormType}"
                            FontSize="12" 
                            Style="{StaticResource CustomPickerStyle}"
                            HorizontalTextAlignment="Center"
                            TextColor="Black" 
                            BackgroundColor="#F0F0F0"/>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        
        <!--Direct to payment when necessary for the receipt to be printed on the paper-->
        <!--Buttons-->
        <VerticalStackLayout Grid.Row="2"
                             WidthRequest="400"
                             HeightRequest="70"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Padding="8"
                             BackgroundColor="#b7b7b7b7">

            <Border StrokeShape="RoundRectangle 30" 
                    WidthRequest="150"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    HeightRequest="45">
                <Button Text="Submit" 
                        BackgroundColor="#1f0572" 
                        TextColor="White" 
                        FontSize="12" 
                        CornerRadius="10" 
                        HorizontalOptions="Center" 
                        VerticalOptions="Center"
                        WidthRequest="250" 
                        HeightRequest="50" 
                        Command="{Binding GotoPaymentCommand}"/>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>