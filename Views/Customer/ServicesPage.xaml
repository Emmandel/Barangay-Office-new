<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:control="clr-namespace:Barangay_Office.Controls"
             xmlns:vm="clr-namespace:Barangay_Office.ViewModels.CustomerViewModel"
             xmlns:converter="clr-namespace:Barangay_Office.Converters"
             x:Class="Barangay_Office.Views.Customer.ServicesPage"
             x:DataType="vm:ServicesPageViewModel"
             BackgroundColor="{AppThemeBinding Light={DynamicResource Gray200}, Dark={DynamicResource Gray600}}"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:EntryVisibilityConverter x:Key="EntryVisibilityConverter"/>
        </ResourceDictionary>    
    </ContentPage.Resources>
    
    <ContentPage.BindingContext>
        <vm:ServicesPageViewModel/>
    </ContentPage.BindingContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- for banner layout -->
        <Path Data="m0,-10.5l699.00002, 0l0,110 -800, 0l0,-536.27948z">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="Red" Offset="0.1" />
                    <GradientStop Color="Blue" Offset="1.0" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- for Logo -->
        <StackLayout Margin="-85">
            <Border BackgroundColor="{AppThemeBinding Dark=White, Light=Black}" 
                    HeightRequest="60" 
                    WidthRequest="60" 
                    StrokeShape="RoundRectangle 30" 
                    Padding="0" 
                    Margin="0,100,0,0" 
                    HorizontalOptions="Center">
                <Image Source="barangay_pembo.png" 
                       Aspect="AspectFill" 
                       Margin="0"/>
            </Border>
        </StackLayout>

        <!-- Header menu -->
        <control:CustomerHeaderMenuControls/>

        <!-- Devider -->
        <BoxView HeightRequest="2" 
                 BackgroundColor="{AppThemeBinding Light=#2C3E50, Dark={StaticResource Gray200}}" 
                 Margin="0,85,0,0" 
                 VerticalOptions="Center"/>

        <!-- List of all services
        *Health Services
        *Emergency Services
        *Community Forums
        *Document Tracking
        *Local Business Directory-->
        
        <ScrollView Grid.Row="1" 
                    BackgroundColor="Transparent"
                    HeightRequest="500" 
                    Margin="0,0,0,65"
                    x:DataType="vm:ServicesPageViewModel">
            <VerticalStackLayout Spacing="10" 
                                 Padding="13">

                <!-- Title -->
                <Label Text="Application Form" 
                       FontSize="Header" 
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" 
                       FontFamily="OpenSansRegular" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       Margin="0,10,0,10" />

                <!-- General Information -->
                <Border Stroke="{AppThemeBinding Light=#2C3E50, Dark=White}" 
                        StrokeShape="RoundRectangle 10" 
                        Padding="15" 
                        BackgroundColor="{AppThemeBinding Dark=Gray, Light=White}">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="General Information" 
                               FontSize="Small" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        
                        <!-- Services Picker -->
                        <Label Text="Select Services" 
                               FontSize="20" 
                               FontAttributes="Bold"
                               HorizontalOptions="Start" 
                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Border Stroke="#2C3E50" 
                                StrokeShape="RoundRectangle 10" 
                                Padding="2" 
                                BackgroundColor="Transparent">
                            <Picker Title="Select-Form-Type" 
                                    ItemsSource="{Binding FormTypes}"
                                    SelectedItem="{Binding SelectedFormType}"
                                    FontSize="12" 
                                    Style="{StaticResource CustomPickerStyle}"
                                    HorizontalTextAlignment="Center"
                                    TitleColor="{AppThemeBinding Dark=White, Light=Black}"
                                    TextColor="{AppThemeBinding Dark=White, Light=Black}"/>
                        </Border>
                        
                        <!--Fullname-->
                        <HorizontalStackLayout WidthRequest="300"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Spacing="15"
                                               BackgroundColor="Transparent">
                            
                            <!--Firstname-->
                            <Entry Placeholder="Firstname" 
                                   x:Name="Firstname" 
                                   FontSize="12" 
                                   TextTransform="Uppercase"
                                   WidthRequest="95"
                                   IsVisible="{Binding EntryVisibility, Converter={StaticResource EntryVisibilityConverter}, ConverterParameter=Firstname}"
                                   PlaceholderColor="{AppThemeBinding Light=Black, Dark=White}"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                            
                            <!--Lastname-->
                            <Entry Placeholder="Lastname" 
                                   x:Name="Lastname" 
                                   WidthRequest="120"
                                   TextTransform="Uppercase"
                                   IsVisible="{Binding EntryVisibility, Converter={StaticResource EntryVisibilityConverter}, ConverterParameter=Lastname}"
                                   FontSize="12" 
                                   PlaceholderColor="{AppThemeBinding Light=Black, Dark=White}"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                            
                            <!--Middlename-->
                            <Entry Placeholder="M.I" 
                                   x:Name="Middlename" 
                                   WidthRequest="20"
                                   HorizontalTextAlignment="Center"
                                   FontSize="12" 
                                   MaxLength="1"
                                   TextTransform="Uppercase"
                                   IsVisible="{Binding EntryVisibility, Converter={StaticResource EntryVisibilityConverter}, ConverterParameter=Middlename}"
                                   PlaceholderColor="{AppThemeBinding Light=Black, Dark=White}"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        </HorizontalStackLayout>
                        
                        <!--Address-->
                        <Entry Placeholder="Address" 
                               x:Name="AddressEntry" 
                               PlaceholderColor="{AppThemeBinding Light=Black, Dark=White}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               FontSize="12" 
                               IsVisible="{Binding EntryVisibility, Converter={StaticResource EntryVisibilityConverter}, ConverterParameter=Address}"/>
                        
                        <!--Gender-->
                        <VerticalStackLayout IsVisible="{Binding EntryVisibility, Converter={StaticResource EntryVisibilityConverter}, ConverterParameter=Gender}">
                            
                            <Label Text="Gender: "
                                   FontSize="12"
                                   Margin="0"
                                   Padding="0"
                                   TextColor="{AppThemeBinding Dark=White, Light=Black}"/>
                            <HorizontalStackLayout Spacing="50"
                                                   HorizontalOptions="Start"
                                                   Margin="0,0,0,0">
                                <RadioButton GroupName="Gender"
                                             BorderColor="Black"
                                             TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                             Content="Male"
                                             IsChecked="{Binding IsMale}"/>
                                <RadioButton GroupName="Gender"
                                             TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                             Content="Female"
                                             IsChecked="{Binding IsFemale}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!--Citizenship-->
                        <Entry Placeholder="Citizenship" 
                               x:Name="CitizenshipEntry" 
                               PlaceholderColor="{AppThemeBinding Light=Black, Dark=White}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               IsVisible="{Binding EntryVisibility, Converter={StaticResource EntryVisibilityConverter}, ConverterParameter=Citizenship}"
                               FontSize="12" />
                        
                        <!--ICR No.-->
                        <Entry Placeholder="ICR No.(If an alien)" 
                               x:Name="ICREntry" 
                               PlaceholderColor="{AppThemeBinding Light=Black, Dark=White}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               Keyboard="Numeric"
                               MaxLength="12"
                               IsVisible="{Binding EntryVisibility, Converter={StaticResource EntryVisibilityConverter}, ConverterParameter=ICR}"
                               FontSize="12"/>
                        
                        <!--Place of Birth-->
                        <Label Text="Place of Birth:"
                                TextColor="{AppThemeBinding Dark=White, Light=Black}"
                                FontSize="12"
                                Margin="0"
                               Padding="0"/>
                        <HorizontalStackLayout BackgroundColor="Transparent"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Padding="0"
                                               Margin="0,-15,0,0"
                                               Spacing="5">
                            <!--Province-->
                            <Picker Title="Province"
                                    ItemsSource="{Binding Provinces}"
                                    SelectedItem="{Binding SelectedProvince}"
                                    TitleColor="{AppThemeBinding Dark=White, Light=Black}"
                                    TextColor="{AppThemeBinding Dark=White, Light=Black}"
                                    FontSize="12"
                                    HorizontalTextAlignment="Center"/>
                            <!--Municipal-->
                            <Picker Title="Municipal"
                                    ItemsSource="{Binding Municipalities}"
                                    SelectedItem="{Binding SelectedMunicipality}"
                                    HorizontalTextAlignment="Center"
                                    TitleColor="{AppThemeBinding Dark=White, Light=Black}"
                                    TextColor="{AppThemeBinding Dark=White, Light=Black}"/>
                            <!--Barangay-->
                            <Picker Title="Barangay"
                                    ItemsSource="{Binding Barangays}"
                                    HorizontalTextAlignment="Center"
                                    TitleColor="{AppThemeBinding Dark=White, Light=Black}"
                                    TextColor="{AppThemeBinding Dark=White, Light=Black}"/>
                        </HorizontalStackLayout>

                        <!--Date-->
                        <VerticalStackLayout IsVisible="True">
                            
                            <Label Text=" BirthDate:" 
                                   TextColor="{AppThemeBinding Dark=White, Light=Black}" 
                                   FontSize="12"/>
                            <DatePicker Format="MM/dd/yyyy" 
                                        Date="{Binding SelectedDate}"
                                        TextColor="{AppThemeBinding Dark=White, Light=Black}" 
                                        FontSize="12" />
                        </VerticalStackLayout>
                        
                        <!--Height-->
                        <Entry Placeholder="Height" 
                               x:Name="HeightEntry"
                               TextColor="{AppThemeBinding Dark=White, Light=Black}"
                               IsVisible="{Binding EntryVisibility, Converter={StaticResource EntryVisibilityConverter}, ConverterParameter=Height}"
                               FontSize="12" />
                        
                        <!--Weight-->
                        <Entry Placeholder="Weight" 
                               x:Name="WeightEntry"
                               IsVisible="{Binding EntryVisibility, Converter={StaticResource EntryVisibilityConverter}, ConverterParameter=Weight}"
                               TextColor="{AppThemeBinding Dark=White, Light=Black}"
                               FontSize="12" />
                        
                        <!--Civil Status-->
                        <HorizontalStackLayout Spacing="50"
                                               HorizontalOptions="Start"
                                               Margin="0,0,0,0">
                            <RadioButton GroupName="BMI"
                                         BorderColor="Black"
                                         TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                         Content="Single"
                                         IsChecked="{Binding IsSingle}"/>
                            <RadioButton GroupName="BMI"
                                         TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                         Content="Married"
                                         IsChecked="{Binding IsMarried}"/>
                        </HorizontalStackLayout>

                        <!--Contact No-->
                        <Entry Placeholder="Contact Number" 
                               x:Name="ContactNumberEntry" 
                               Keyboard="Telephone" 
                               FontSize="12" 
                               TextColor="Black"/>
                        
                        <!--Email Address-->
                        <Entry Placeholder="Email Address" 
                               x:Name="EmailAddressEntry" 
                               TextColor="Black"
                               Keyboard="Email" 
                               FontSize="12" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
        
        <!--Direct to payment when necessary for the receipt to be printed on the paper-->
        <!--Buttons-->
        <VerticalStackLayout Grid.Row="2"
                             WidthRequest="400"
                             HeightRequest="70"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Padding="8"
                             BackgroundColor="#b7b7b7b7">

            <Border StrokeShape="RoundRectangle 30" 
                    WidthRequest="150"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    HeightRequest="45">
                <Button Text="Submit" 
                        BackgroundColor="#1f0572" 
                        TextColor="White" 
                        FontSize="12" 
                        CornerRadius="10" 
                        HorizontalOptions="Center" 
                        VerticalOptions="Center"
                        WidthRequest="250" 
                        HeightRequest="50" 
                        Command="{Binding OnSubmit}"/>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>