<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:control="clr-namespace:Barangay_Office.Views.Controls"
             xmlns:vm="clr-namespace:Barangay_Office.ViewModels"
             x:Class="Barangay_Office.Views.ServicesPage"
             Title="ServicesPage"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">
    
    <ContentPage.BindingContext>
        <vm:CustomerPageViewModel/>
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="13">
            <!--header menu-->
            <control:CustomerHeaderMenuControls/>

            <!-- Devider -->
            <BoxView HeightRequest="2" BackgroundColor="#2C3E50" />

            <!-- Title -->
            <Label Text="Application Form" FontSize="26" TextColor="Black" FontFamily="OpenSansRegular" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,10" />

            <!-- General Information -->
            <Frame BorderColor="#2C3E50" CornerRadius="10" Padding="15" BackgroundColor="#F0F0F0">
                <VerticalStackLayout Spacing="12">

                    <Label Text="General Information" FontSize="20" FontAttributes="Bold" TextColor="#2C3E50" />
                    <Entry Placeholder="Full Name" x:Name="FullNameEntry" FontSize="16" />
                    <Entry Placeholder="Address" x:Name="AddressEntry" FontSize="16" />
                    <Label Text=" BirthDate:" TextColor="Grey" FontSize="16"/>
                    <DatePicker x:Name="DateOfBirthPicker" Format="MM/dd/yyyy" TextColor ="Grey" FontSize="16" />
                    <Entry Placeholder="Contact Number" x:Name="ContactNumberEntry" Keyboard="Telephone" FontSize="16" />
                    <Entry Placeholder="Email Address" x:Name="EmailAddressEntry" Keyboard="Email" FontSize="16" />

                </VerticalStackLayout>
            </Frame>

            <!-- Services ComboBox -->
            <Label Text="Select Services" FontSize="20" FontAttributes="Bold" HorizontalOptions="Start" TextColor="#2C3E50" />


            <Frame BorderColor="#2C3E50" CornerRadius="10" Padding="10" BackgroundColor="White">
                <Picker Title="Select Form Type" ItemsSource="{Binding FormTypes}" FontSize="16" TextColor="#2C3E50" BackgroundColor="#F0F0F0"/>
            </Frame>

            <Button Text="Go to Payment" BackgroundColor="Indigo" TextColor="White" FontSize="18" CornerRadius="10" HorizontalOptions="Center" WidthRequest="250" HeightRequest="50" Command="{Binding GotoPaymentCommand}"  />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>