<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Barangay_Office.Views.ForgotPasswordPage"
             xmlns:vm="clr-namespace:Barangay_Office.ViewModels"
             Title="Forgot Password Page"
             Shell.FlyoutBehavior="Disabled">

    <ContentPage.BindingContext>
        <vm:ForgotPasswordViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <Style x:Key="EntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalOptions" Value="FillAndExpand"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
    </ContentPage.Resources>

    <Grid
        BackgroundColor = "#d0d0d0" >
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>


        <!-- for banner layout -->
        <Path Data="m0,-10.5l699.00002, 0l0,110 -800, 0l0,-536.27948z">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="Red" Offset="0.1" />
                    <GradientStop Color="Blue" Offset="1.0" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- for Logo -->
        <StackLayout Margin="-85">
            <Border BackgroundColor="Black" 
                HeightRequest="60" 
                WidthRequest="60" 
                StrokeShape="RoundRectangle 30" 
                Padding="0" 
                Margin="0,100,0,0" 
                HorizontalOptions="Center">
                <Image Source="barangay_pembo.png" 
                   Aspect="AspectFill" 
                   Margin="0"/>
            </Border>
        </StackLayout>


        <Grid RowSpacing="5"
          Grid.Row="1"
          Margin="20,20,20,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="160"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- Introduction -->
            <Label Text="Enter your Registered Email to reset the password."
                   FontSize="Small"
                   HorizontalOptions="CenterAndExpand"
                   VerticalOptions="Center"
                   Margin="0,-400,0,0"
                   Padding="0,0,0,0"
                   HorizontalTextAlignment="Center"
                   Grid.Row="1" 
                   TextColor="Black"/>


            <StackLayout Grid.Row="2"
                         Orientation="Vertical"
                         Margin="0,-100,0,0"
                         HorizontalOptions="CenterAndExpand">
                
                <Label Text="{Binding Message}" TextColor="{Binding BorderColor}" HorizontalOptions="Center" FontSize="Micro"/>

                <!-- Email -->
                <Border
                    BackgroundColor="Transparent"
                    Stroke="{Binding BorderColor}"
                    Padding="0"
                    Margin="0,0,0,10"
                    HorizontalOptions="FillAndExpand"
                    StrokeShape="RoundRectangle 30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <Border 
                            BackgroundColor="Transparent"
                            WidthRequest="40"
                            StrokeShape="RoundRectangle 30" 
                            Padding="0"
                            Margin="5"
                            Stroke="Transparent"
                            Grid.Column="0">
                            <Image 
                                Source="/user.png" 
                                Aspect="AspectFill"
                                Margin="5"/>
                        </Border>
                        <Entry x:Name="EmailEntry" 
                               Placeholder="Enter your email" 
                               Text="{Binding Email}"
                               Style="{StaticResource EntryStyle}"
                               Margin="0,0,75,0"
                               Grid.Column="1" 
                               Keyboard="Email"/>
                    </Grid>
                </Border>

                <!-- password -->
                <Border
                    BackgroundColor="Transparent"
                    Stroke="{Binding BorderColor}"
                    Padding="0"
                    HorizontalOptions="FillAndExpand"
                    StrokeShape="RoundRectangle 30">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Border 
                        BackgroundColor="Transparent"
                        HeightRequest="40"
                        WidthRequest="40"
                        StrokeShape="RoundRectangle 30" 
                        Padding="0"
                        Stroke="Transparent"
                        Margin="5"
                        Grid.Column="0">

                            <Image 
                                Source="lock.png" 
                                Aspect="AspectFill"
                                Margin="5"/>
                        </Border>
                        <Entry x:Name="NewPasswordEntry" 
                               Placeholder="Enter new password" 
                               Grid.Column="1"
                               Text="{Binding NewPassword}"
                               Style="{StaticResource EntryStyle}"
                               IsPassword="True"/>
                               <ImageButton Source="close_eye.png"
                                     Clicked="OntoggleFPasswordVisibility"
                                     WidthRequest="5"
                                     HeightRequest="5"
                                     VerticalOptions="Center"
                                     Margin="0,0,10,0"
                                     Grid.Column="2"/>
                    </Grid>
                </Border>


                <!-- Reset Button -->
                <Button Text="Reset Password" 
                        TextColor="#ffffff"
                        WidthRequest="200"
                        Margin="0,15,0,0"
                        BackgroundColor="#e63c3f"
                        CornerRadius="30"
                        BorderColor="#1f0572"
                        BorderWidth="1"
                        Command="{Binding ResetPasswordCommand}"/>

            </StackLayout>
        </Grid>

    </Grid>

</ContentPage>