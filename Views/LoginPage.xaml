<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Barangay_Office.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             xmlns:vm="clr-namespace:Barangay_Office.ViewModels"
             Title="LoginPage"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:LoginViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <Style x:Key="EntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="WidthRequest" Value="150"/>
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
    </ContentPage.Resources>

    

    <Grid BackgroundColor = "#d0d0d0" >
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        
        <!-- for banner layout -->
        <Path Data="m0,-10.5l699.00002, 0l0,110 -800, 0l0,-536.27948z">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="Red" Offset="0.1" />
                    <GradientStop Color="Blue" Offset="1.0" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- for Logo -->
        <StackLayout Margin="-85">
            <Border BackgroundColor="Black" 
                    HeightRequest="60" 
                    WidthRequest="60" 
                    StrokeShape="RoundRectangle 30" 
                    Padding="0" 
                    Margin="0,100,0,0" 
                    HorizontalOptions="Center">
                <Image Source="barangay_pembo.png" 
                       Aspect="AspectFill" 
                       Margin="0"/>
            </Border>
        </StackLayout>


        <Grid RowSpacing="5"
              Grid.Row="1"
              Margin="20,20,20,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- Introduction -->
            <Label 
                Grid.Row="1" 
                Text="Welcome!" 
                HorizontalOptions="Center" 
                FontSize="Title" 
                FontAttributes="Bold" 
                Padding="0" 
                Margin="0"
                TextColor="Black"/>
            
            <Label 
                Grid.Row="2" 
                Text="Login to continue!" 
                HorizontalOptions="Center" 
                FontSize="Subtitle"
                TextColor="Black"/>

            <StackLayout Grid.Row="3"
                         Orientation="Vertical"
                         HorizontalOptions="Center">

                <Label Text="{Binding Message}" 
                       TextColor="{Binding BorderColor}" 
                       HorizontalOptions="Center" 
                       FontAttributes="Bold"
                       FontSize="Micro"/>

                <!-- Email -->
                <Border BackgroundColor="Transparent"
                        Stroke="{Binding EmailColor}"
                        Padding="0"
                        Margin="0,0,0,10"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <Border BackgroundColor="Transparent"
                                HeightRequest="40"
                                WidthRequest="40"
                                StrokeShape="RoundRectangle 30" 
                                Padding="0"
                                Margin="5"
                                Stroke="Transparent"
                                Grid.Column="0">
                            <Image  Source="/user.png" 
                                    Aspect="AspectFill"
                                    Margin="5"/>
                        </Border>
                        <Entry 
                            x:Name="txtEmail"
                            Text="{Binding Email}" 
                            Placeholder="Email"
                            Keyboard="Email"
                            Style="{StaticResource EntryStyle}"
                            Grid.Column="1"
                            Margin="0,0,75,0"/>
                    </Grid>
                </Border>

                <!-- password -->
                <Border BackgroundColor="Transparent"
                        Stroke="{Binding PasswordColor}"
                        Padding="0"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 30">
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Border BackgroundColor="Transparent"
                                HeightRequest="40"
                                WidthRequest="40"
                                StrokeShape="RoundRectangle 30" 
                                Padding="0"
                                Stroke="Transparent"
                                Margin="5"
                                Grid.Column="0">
                            
                            <Image  Source="lock.png" 
                                    Aspect="AspectFill"
                                    Margin="5"/>
                        </Border>
                        <Entry x:Name="PasswordEntry"
                               Text="{Binding Password}" 
                               Placeholder="Password"
                               IsPassword="True"
                               Style="{StaticResource EntryStyle}"
                               Grid.Column="1"/>
                        <ImageButton Source="close_eye.png"
                                     Clicked="OntogglePasswordVisibility"
                                     WidthRequest="5"
                                     Aspect="AspectFit"
                                     HeightRequest="5"
                                     Scale="0.8"
                                     VerticalOptions="Center"
                                     Margin="0,0,10,0"
                                     Grid.Column="2"/>
                    </Grid>
                </Border>

                <StackLayout Orientation="Horizontal" 
                             Margin="0,10,0,0" 
                             Padding="0">
                    
                    <!-- Checkbox -->
                    <CheckBox IsChecked="False"
                              Color="Black"
                              Margin="0"
                              VerticalOptions="Center"
                              HorizontalOptions="Center"/>
                    <Label
                        Text="Remember me"
                        TextColor="Black"
                        FontSize="Small"
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="Center"
                        Margin="0"/>
                    <Label Margin="5"
                           Text="Forgot Password?"
                           TextColor="Blue"
                           FontAttributes="Bold"
                           HorizontalOptions="End"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="LinkToForgotPassword"/>
                        </Label.GestureRecognizers>
                    </Label>

                </StackLayout>

                <!-- Login Button -->
                <Button 
                    Text="Log in" 
                    TextColor="#ffffff"
                    WidthRequest="200"
                    Margin="0,15,0,0"
                    Command="{Binding LoginCommand}"
                    BackgroundColor="#e63c3f"
                    CornerRadius="30"
                    BorderColor="#1f0572"
                    BorderWidth="1"/>
                
                <!-- Biometric Button for customer -->
                <Button 
                    Text="Login with Biometric" 
                    TextColor="#ffffff"
                    WidthRequest="200"
                    FontSize="12"
                    Margin="0,8,0,0"
                    Command="{Binding BiometricLoginCommand}"
                    IsVisible="{Binding IsBiometricEnabled}"
                    BackgroundColor="#38187c"
                    CornerRadius="30"
                    BorderColor="#1f0572"
                    BorderWidth="1"/>

                <StackLayout Orientation="Horizontal" 
                     HorizontalOptions="Center" 
                     Margin="0,20,0,0" 
                     Padding="0">
                    <Label 
                        Text="Not yet registered?"
                        FontSize="Small"
                        Margin="0,0,10,0"
                        TextColor="Black"/>
                    <Label
                        Text="Register here."
                        FontAttributes="Bold"
                        FontSize="Small"
                        TextColor="Blue">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="LinkToSignup"/>
                        </Label.GestureRecognizers>
                    </Label>

                </StackLayout>

            </StackLayout>
        </Grid>

    </Grid>
</ContentPage>