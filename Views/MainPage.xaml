<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:control="clr-namespace:Barangay_Office.Views.Controls"
             x:Class="Barangay_Office.MainPage"
             BackgroundColor="LightGray"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="13">
            <!--header menu-->
            <control:AdminHeaderMenuControls/>

            <!-- Devider -->
            <BoxView HeightRequest="2" BackgroundColor="#2C3E50" />

            <Label 
                Text="Welcome Admin!"
                VerticalOptions="Center" 
                HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
