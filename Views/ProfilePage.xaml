<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Barangay_Office.Views.ProfilePage"
             xmlns:control="clr-namespace:Barangay_Office.Views.Controls"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">
    <ScrollView>
        

        <!-- add Customer name , exit button, move the customer service here -->
        
            <VerticalStackLayout Padding="13" Spacing="10">
            <!--header menu-->
            <control:CustomerHeaderMenuControls/>
                
                <Label 
                    Text="Customer Profile Page"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" />

                <!-- Add Customer Service-->
            
                <Button Grid.Row="1"
                        Text="Reset Password"
                        Clicked="ToReset"/>
            
                <Button 
                    Grid.Row="2"
                    Text="logout"
                    Clicked="OutButton_Clicked"/>
            </VerticalStackLayout>
        
    </ScrollView>
</ContentPage>